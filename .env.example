PORT=3000
NODE_ENV=development
# Secret required in the x-api-key header for POST/PUT/DELETE. Use a long random value.
API_KEY=replace-this-with-a-long-random-secret
# Optional: SQLite file location (defaults to ./data/tasks.db)
# DB_PATH=./data/tasks.db
# Optional: insert sample tasks on startup when the table is empty
# SEED_ON_EMPTY=true
